# ByteBurrow configuration.
#
# Config is read from the environment (this file is loaded automatically at
# startup) using the `BYTEBURROW__` prefix — every variable must be named
# `BYTEBURROW__<NAME>`. Copy this file to `.env` and fill in the required values.
#
# Note: the frontend is embedded into the server binary at compile time via
# `rust_embed`, so there is NO frontend-directory variable — rebuild to pick up
# frontend changes.

# --- Required ---
BYTEBURROW__DATABASE_URL=postgres://user:password@localhost:5432/byteburrow
BYTEBURROW__SALT=change-me-to-a-long-random-secret

# --- Optional (defaults shown) ---
# BYTEBURROW__SERVER_ADDR=0.0.0.0:3000
# BYTEBURROW__THUMBNAIL_STORAGE=/tmp/thumbnails
# BYTEBURROW__BASE_URL=http://localhost:3000
# BYTEBURROW__TOKEN_EXPIRATION_DAYS=30
# BYTEBURROW__TOKEN_LENGTH=32
# BYTEBURROW__PLUGIN_DIR=/etc/byteburrow/plugins
# BYTEBURROW__IGNORE_PATTERNS=.git,.cache,node_modules,.DS_Store,__pycache__,.Trash

# Face recognition: the single "is this a known person" decision, shared by the
# job pipeline and the CLI `face_match` tool.
# - THRESHOLD: minimum cosine similarity of the best contact for a match.
# - MARGIN: minimum gap to the best *different* contact; rejects ambiguous
#   matches where two people are almost equally close. Set to 0 to disable.
# BYTEBURROW__FACE_MATCH_THRESHOLD=0.8
# BYTEBURROW__FACE_MATCH_MARGIN=0.05

# Comma-separated list of origins allowed to make cross-origin requests (CORS).
# Empty by default (cross-origin access disabled). Only set this when the
# frontend is served from a different origin than the API.
# BYTEBURROW__CORS_ALLOWED_ORIGINS=https://app.example.com

# Only enable when behind a reverse proxy that sets X-Forwarded-For / X-Real-IP
# itself — otherwise clients can spoof them. Defaults to false (real TCP peer).
# BYTEBURROW__TRUST_FORWARDED_HEADERS=false
